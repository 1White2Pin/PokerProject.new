<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#1B5E20" android:endColor="#0A2E0D" android:angle="270"/>
            <corners android:radius="10dp"/>
            <stroke android:width="1.5dp" android:color="#69F0AE"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#2E7D32" android:endColor="#145214" android:angle="270"/>
            <corners android:radius="10dp"/>
            <stroke android:width="1dp" android:color="#81C784"/>
        </shape>
    </item>
</selector>
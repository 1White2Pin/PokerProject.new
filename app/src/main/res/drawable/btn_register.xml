<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#9A7810" android:endColor="#6B5200" android:angle="270"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#C8A84B" android:endColor="#8A6820" android:angle="270"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="#E8CC7A"/>
        </shape>
    </item>
</selector>
<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#7B1010" android:endColor="#4A0808" android:angle="270"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1.5dp" android:color="#FF6B6B"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#C0392B" android:endColor="#7B1515" android:angle="270"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="#FF6B6B"/>
        </shape>
    </item>
</selector>
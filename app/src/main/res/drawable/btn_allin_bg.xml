<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#6A0572" android:endColor="#3D0042" android:angle="270"/>
            <corners android:radius="10dp"/>
            <stroke android:width="1.5dp" android:color="#E040FB"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#8E24AA" android:endColor="#4A0058" android:angle="270"/>
            <corners android:radius="10dp"/>
            <stroke android:width="1dp" android:color="#CE93D8"/>
        </shape>
    </item>
</selector>
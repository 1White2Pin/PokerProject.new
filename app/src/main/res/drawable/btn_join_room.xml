<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#0D47A1" android:endColor="#062069" android:angle="270"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1.5dp" android:color="#82B1FF"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#1565C0" android:endColor="#0A2F6B" android:angle="270"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="#64B5F6"/>
        </shape>
    </item>
</selector>
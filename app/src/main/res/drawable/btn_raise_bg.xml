<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#7A5500" android:endColor="#4A3200" android:angle="270"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1.5dp" android:color="#FFD700"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#B8860B" android:endColor="#6B4E00" android:angle="270"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="#C8A84B"/>
        </shape>
    </item>
</selector>
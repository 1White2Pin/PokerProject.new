<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/waitingLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070D07"
    android:orientation="horizontal"
    android:padding="20dp">

    <!-- ══ LEFT PANEL ══ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.85"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingEnd="18dp">

        <!-- Room Code Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#00000000"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_room_code_card"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="20dp"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ROOM CODE"
                    android:textColor="#88C8A84B"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.3"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvRoomCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="----"
                    android:textColor="#C8A84B"
                    android:textSize="44sp"
                    android:textStyle="bold"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="3"
                    android:shadowRadius="10"/>

                <View
                    android:layout_width="50dp"
                    android:layout_height="1dp"
                    android:background="#44C8A84B"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Admin Panel -->
        <LinearLayout
            android:id="@+id/adminPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_admin_panel"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STARTING CHIPS"
                android:textColor="#88C8A84B"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.25"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <Button
                    android:id="@+id/btnMinusChips"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:text="−"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_chips_minus"
                    android:stateListAnimator="@null"
                    android:padding="0dp"/>

                <TextView
                    android:id="@+id/tvChipsValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="10000"
                    android:textColor="#C8A84B"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_chips_value"
                    android:paddingVertical="8dp"
                    android:layout_marginHorizontal="8dp"/>

                <Button
                    android:id="@+id/btnPlusChips"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:text="+"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_chips_plus"
                    android:stateListAnimator="@null"
                    android:padding="0dp"/>
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbIsPrivate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Private Room"
                android:textColor="#AAFFFFFF"
                android:textSize="13sp"
                android:buttonTint="#C8A84B"
                android:layout_marginBottom="14dp"/>

            <Button
                android:id="@+id/btnStartGame"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="START GAME"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#1A0E00"
                android:letterSpacing="0.1"
                android:background="@drawable/btn_start_game"
                android:stateListAnimator="@null"
                android:elevation="8dp"/>
        </LinearLayout>

        <!-- Guest waiting -->
        <LinearLayout
            android:id="@+id/guestMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_admin_panel"
            android:padding="20dp"
            android:visibility="visible">

            <ProgressBar
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminateTint="#C8A84B"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvWaitMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waiting for host..."
                android:textColor="#88FFFFFF"
                android:textSize="12sp"
                android:letterSpacing="0.05"/>
        </LinearLayout>

    </LinearLayout>

    <!-- ══ RIGHT PANEL — SEATS ══ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.15"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PLAYERS"
            android:textColor="#55C8A84B"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.3"
            android:layout_marginBottom="12dp"/>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="2"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false">

            <!-- Seat 1 -->
            <LinearLayout
                android:id="@+id/seat1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_seat_card"
                android:padding="14dp"
                android:layout_margin="6dp">

                <ImageView
                    android:id="@+id/ivPlayer1"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:background="@drawable/bg_avatar_circle"
                    android:padding="10dp"
                    app:tint="#55C8A84B"/>

                <TextView
                    android:id="@+id/tvPlayer1Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Empty"
                    android:textColor="#44FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"/>

                <Button
                    android:id="@+id/btnKick1"
                    android:layout_width="64dp"
                    android:layout_height="30dp"
                    android:text="KICK"
                    android:textSize="9sp"
                    android:textColor="#FFCDD2"
                    android:background="@drawable/btn_kick"
                    android:stateListAnimator="@null"
                    android:layout_marginTop="6dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Seat 2 -->
            <LinearLayout
                android:id="@+id/seat2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_seat_card"
                android:padding="14dp"
                android:layout_margin="6dp">

                <ImageView
                    android:id="@+id/ivPlayer2"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:background="@drawable/bg_avatar_circle"
                    android:padding="10dp"
                    app:tint="#55C8A84B"/>

                <TextView
                    android:id="@+id/tvPlayer2Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Empty"
                    android:textColor="#44FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"/>

                <Button
                    android:id="@+id/btnKick2"
                    android:layout_width="64dp"
                    android:layout_height="30dp"
                    android:text="KICK"
                    android:textSize="9sp"
                    android:textColor="#FFCDD2"
                    android:background="@drawable/btn_kick"
                    android:stateListAnimator="@null"
                    android:layout_marginTop="6dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Seat 3 -->
            <LinearLayout
                android:id="@+id/seat3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_seat_card"
                android:padding="14dp"
                android:layout_margin="6dp">

                <ImageView
                    android:id="@+id/ivPlayer3"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:background="@drawable/bg_avatar_circle"
                    android:padding="10dp"
                    app:tint="#55C8A84B"/>

                <TextView
                    android:id="@+id/tvPlayer3Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Empty"
                    android:textColor="#44FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"/>

                <Button
                    android:id="@+id/btnKick3"
                    android:layout_width="64dp"
                    android:layout_height="30dp"
                    android:text="KICK"
                    android:textSize="9sp"
                    android:textColor="#FFCDD2"
                    android:background="@drawable/btn_kick"
                    android:stateListAnimator="@null"
                    android:layout_marginTop="6dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Seat 4 -->
            <LinearLayout
                android:id="@+id/seat4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_seat_card"
                android:padding="14dp"
                android:layout_margin="6dp">

                <ImageView
                    android:id="@+id/ivPlayer4"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:background="@drawable/bg_avatar_circle"
                    android:padding="10dp"
                    app:tint="#55C8A84B"/>

                <TextView
                    android:id="@+id/tvPlayer4Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Empty"
                    android:textColor="#44FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"/>

                <Button
                    android:id="@+id/btnKick4"
                    android:layout_width="64dp"
                    android:layout_height="30dp"
                    android:text="KICK"
                    android:textSize="9sp"
                    android:textColor="#FFCDD2"
                    android:background="@drawable/btn_kick"
                    android:stateListAnimator="@null"
                    android:layout_marginTop="6dp"
                    android:visibility="gone"/>
            </LinearLayout>

        </GridLayout>
    </LinearLayout>

</LinearLayout>
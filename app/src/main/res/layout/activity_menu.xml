<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainMenu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070D07">

    <!-- קישוט ♣ שמאל למטה -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="♣"
        android:textColor="#07C8A84B"
        android:textSize="220sp"
        android:rotation="-20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="-40dp"
        android:layout_marginBottom="-40dp"/>

    <!-- קישוט ♦ ימין למעלה -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="♦"
        android:textColor="#07C8A84B"
        android:textSize="160sp"
        android:rotation="15"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="-30dp"
        android:layout_marginTop="-20dp"/>

    <!-- תוכן ראשי -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="28dp">

        <!-- ══ LEFT — כותרת + תיאור ══ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingEnd="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♠  POKER  ♠"
                android:textColor="#33C8A84B"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.4"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome, Player"
                android:textColor="#C8A84B"
                android:textSize="38sp"
                android:textStyle="bold"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="12"
                android:layout_marginBottom="14dp"/>

            <!-- קו זהוב -->
            <View
                android:layout_width="70dp"
                android:layout_height="1.5dp"
                android:background="#C8A84B"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose your game mode\nto start earning chips."
                android:textColor="#66FFFFFF"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"/>

            <!-- סטטוס chips בתחתית -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_chips_pill"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MASTER"
                    android:textColor="#55C8A84B"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.3"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ══ RIGHT — כפתורים ══ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="16dp">

            <!-- PLAY ONLINE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_menu_btn_card_red"
                android:padding="18dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MULTIPLAYER"
                    android:textColor="#88FFAAAA"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.25"
                    android:layout_marginBottom="4dp"/>

                <Button
                    android:id="@+id/btnPlayOnline"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="PLAY ONLINE"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFCDD2"
                    android:letterSpacing="0.08"
                    android:background="@drawable/btn_menu_red"
                    android:stateListAnimator="@null"
                    android:elevation="6dp"
                    app:icon="@android:drawable/ic_menu_share"
                    app:iconTint="#FFCDD2"
                    app:iconGravity="textStart"/>
            </LinearLayout>

            <!-- PRACTICE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_menu_btn_card_blue"
                android:padding="18dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SINGLE PLAYER"
                    android:textColor="#88AACCFF"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.25"
                    android:layout_marginBottom="4dp"/>

                <Button
                    android:id="@+id/btnPlayOffline"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="PRACTICE (BOTS)"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#BBDEFB"
                    android:letterSpacing="0.06"
                    android:background="@drawable/btn_menu_blue"
                    android:stateListAnimator="@null"
                    android:elevation="6dp"
                    app:icon="@android:drawable/ic_menu_manage"
                    app:iconTint="#BBDEFB"
                    app:iconGravity="textStart"/>
            </LinearLayout>

            <!-- Logout -->
            <Button
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign Out"
                android:textColor="#33FFFFFF"
                android:textSize="12sp"
                android:background="@android:color/transparent"
                style="?android:attr/borderlessButtonStyle"/>

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>